    "def rotate(pos, a):\n",
    "    \"\"\"Rotate the positions by `a` degrees.\"\"\"\n",
    "    theta = np.radians(a)\n",
    "    c, s = np.cos(theta), np.sin(theta)\n",
    "    R = np.array(((c, -s), (s, c)))\n",
    "    x, y = pos.get_2d_array()\n",
    "    cm = np.array([x.mean(), y.mean()])\n",
    "    return pos.t(lambda x: R @ (x.a - cm) + cm)\n",
